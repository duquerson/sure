<div id="retirement-planner" class="space-y-4">
  <% if missing_input %>
    <div data-planner-needs="<%= missing_input %>">
      <p class="text-sm text-secondary"><%= t("retirement_plans.planner.needs.#{missing_input}") %></p>
      <div class="mt-3">
        <%= render DS::Link.new(text: t("retirement_plans.planner.settings"), variant: "secondary", size: "sm",
                                icon: "settings-2", href: helpers.edit_retirement_plan_path, frame: :modal) %>
      </div>
    </div>
  <% else %>
    <% if fire? %>
      <% if solution.retirement_year %>
        <p class="text-sm text-primary" data-planner-outcome="fire" data-retirement-year="<%= solution.retirement_year %>">
          <%= t("retirement_plans.planner.outcome.fire", year: solution.retirement_year, age: solution.retirement_age) %>
        </p>
      <% else %>
        <p class="text-sm text-warning" data-planner-outcome="fire-unreachable">
          <%= t("retirement_plans.planner.outcome.fire_unreachable", end_age: plan.end_age, age: solution.depletion_age) %>
        </p>
      <% end %>
    <% elsif simulation.survives? %>
      <p class="text-sm text-primary" data-planner-outcome="lasts">
        <%= t("retirement_plans.planner.outcome.lasts", end_age: plan.end_age) %>
      </p>
    <% else %>
      <p class="text-sm text-warning" data-planner-outcome="runs-out">
        <%= t("retirement_plans.planner.outcome.runs_out", age: simulation.depletion_age) %>
      </p>
    <% end %>
    <p class="text-xs text-subdued"><%= t("retirement_plans.planner.assumptions") %></p>

    <% if rows.any? %>
      <div class="w-full h-64 privacy-sensitive"
           data-controller="time-series-chart"
           data-time-series-chart-series-value="<%= chart_series.to_json %>"></div>

      <div class="overflow-x-auto">
        <table id="retirement-planner-table" class="w-full text-sm tabular-nums privacy-sensitive">
          <thead>
            <tr class="text-xs uppercase font-medium text-secondary border-b border-divider">
              <th class="text-left py-2 px-2"><%= t("retirement_plans.planner.columns.year") %></th>
              <th class="text-left py-2 px-2"><%= t("retirement_plans.planner.columns.age") %></th>
              <th class="text-right py-2 px-2"><%= t("retirement_plans.planner.columns.contribution") %></th>
              <th class="text-right py-2 px-2"><%= t("retirement_plans.planner.columns.withdrawal") %></th>
              <th class="text-right py-2 px-2"><%= t("retirement_plans.planner.columns.growth") %></th>
              <th class="text-right py-2 px-2"><%= t("retirement_plans.planner.columns.end_value") %></th>
              <th class="text-right py-2 px-2"><%= t("retirement_plans.planner.columns.end_value_real") %></th>
            </tr>
          </thead>
          <tbody>
            <% rows.each do |row| %>
              <tr class="border-b border-divider <%= "bg-surface-inset" if simulation.depletion_year == row.year %>"
                  data-year="<%= row.year %>" <%= "data-retired" if retired?(row) %>>
                <td class="py-1.5 px-2 text-primary"><%= row.year %></td>
                <td class="py-1.5 px-2 text-secondary"><%= row.age %></td>
                <td class="py-1.5 px-2 text-right text-secondary"><%= money(row.contribution) %></td>
                <td class="py-1.5 px-2 text-right text-secondary"><%= money(row.withdrawal) %></td>
                <td class="py-1.5 px-2 text-right text-secondary"><%= money(row.growth) %></td>
                <td class="py-1.5 px-2 text-right text-primary"><%= money(row.end_value) %></td>
                <td class="py-1.5 px-2 text-right text-secondary"><%= money(row.end_value_real) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% end %>
</div>
