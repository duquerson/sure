<div id="retirement-plan-summary" class="space-y-4">
  <% if fi_number? %>
    <div>
      <p class="text-xs text-secondary"><%= t("retirement_plans.summary.fi_number") %></p>
      <p class="text-3xl font-medium text-primary tabular-nums privacy-sensitive" data-fi-number>
        <%= fi_number_money.format(precision: 0) %>
      </p>
      <p class="text-xs text-subdued mt-1">
        <%= t("retirement_plans.summary.fi_number_explainer",
              expenses: Money.new(projection.annual_expenses, currency).format(precision: 0),
              rate: helpers.number_to_percentage(projection.safe_withdrawal_rate * 100, precision: 2, strip_insignificant_zeros: true)) %>
      </p>
    </div>

    <div>
      <div class="flex items-baseline justify-between text-sm">
        <span class="text-secondary privacy-sensitive"><%= t("retirement_plans.summary.assets", amount: current_assets_money.format(precision: 0)) %></span>
        <span class="text-primary tabular-nums font-medium" data-fi-progress>
          <%= projection.financially_independent? ? t("retirement_plans.summary.independent", percent: progress_percent) : t("retirement_plans.summary.progress", percent: progress_percent) %>
        </span>
      </div>
      <div class="h-1.5 bg-container-inset rounded-full overflow-hidden mt-2"
           role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= bar_percent %>"
           aria-label="<%= t("retirement_plans.summary.progress_aria") %>">
        <div class="h-full <%= projection.financially_independent? ? "bg-success" : "bg-inverse" %> rounded-full"
             data-fi-bar style="inline-size: <%= bar_percent %>%"></div>
      </div>
    </div>

    <dl class="grid grid-cols-2 gap-3 text-sm">
      <div>
        <dt class="text-xs text-secondary"><%= t("retirement_plans.summary.projected_total") %></dt>
        <dd class="text-primary tabular-nums privacy-sensitive">
          <% if projected_total_money %>
            <%= projected_total_money.format(precision: 0) %>
            <span class="text-xs text-subdued"><%= t("retirement_plans.summary.at_retirement", date: I18n.l(projection.retirement_date, format: :long)) %></span>
          <% else %>
            <span class="text-subdued"><%= t("retirement_plans.summary.no_retirement_date") %></span>
          <% end %>
        </dd>
      </div>
      <div>
        <dt class="text-xs text-secondary"><%= t("retirement_plans.summary.savings_rate") %></dt>
        <dd class="text-primary tabular-nums">
          <%= helpers.number_to_percentage(savings_rate_percent, precision: 1, strip_insignificant_zeros: true) %>
          <% if savings_rate_derived? %>
            <span class="text-xs text-subdued"><%= t("retirement_plans.summary.derived") %></span>
          <% end %>
        </dd>
      </div>
    </dl>

    <% if show_chart? %>
      <div class="w-full h-52 privacy-sensitive"
           data-controller="time-series-chart"
           data-time-series-chart-series-value="<%= chart_series.to_json %>"></div>
    <% end %>
  <% else %>
    <p class="text-sm text-secondary"><%= t("retirement_plans.summary.no_expenses") %></p>
  <% end %>

  <% if unconverted_count.positive? %>
    <p class="text-xs text-warning"><%= t("retirement_plans.summary.unconverted", count: unconverted_count) %></p>
  <% end %>

  <div class="flex flex-wrap gap-2">
    <%= render DS::Link.new(text: t("retirement_plans.summary.edit"), variant: "secondary", size: "sm",
                            icon: "settings-2", href: helpers.edit_retirement_plan_path, frame: :modal) %>
    <%= render DS::Link.new(text: t("retirement_plans.summary.planner"), variant: "secondary", size: "sm",
                            icon: "table-2", href: helpers.retirement_plan_path) %>
  </div>
</div>
