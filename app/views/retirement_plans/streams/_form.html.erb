<%# locals: (stream:) %>

<%= styled_form_with model: stream, scope: :retirement_plan_stream,
                     url: stream.persisted? ? retirement_plan_stream_path(stream) : retirement_plan_streams_path,
                     method: stream.persisted? ? :patch : :post, class: "space-y-4" do |f| %>
  <% if stream.errors.any? %>
    <%= render "shared/form_errors", model: stream %>
  <% end %>

  <%= f.select :kind, RetirementPlan::Stream::KINDS.map { |kind| [ t(".kinds.#{kind}"), kind ] }, label: t(".kind") %>
  <%= f.text_field :name, label: t(".name"), required: true %>
  <%= f.number_field :annual_amount, label: t(".annual_amount"), step: "0.01", min: "0.01", required: true %>
  <%= f.number_field :start_year, label: t(".start_year"), step: "1", placeholder: t(".start_year_placeholder") %>
  <%= f.number_field :end_year, label: t(".end_year"), step: "1", placeholder: t(".end_year_placeholder") %>
  <div class="flex items-center justify-between gap-3">
    <%= f.label :indexed, t(".indexed"), class: "text-sm text-primary" %>
    <%= f.toggle :indexed %>
  </div>
  <p class="text-xs text-secondary -mt-2"><%= t(".indexed_hint") %></p>

  <%= f.submit t(".save") %>
<% end %>
